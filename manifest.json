<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>سجل الطلاب</title>
<style>
:root {
    --bg: #f7f1e6;
    --paper: #fffaf0;
    --brown: #6b4a36;
    --brown-2: #8b5e3c;
    --accent: #c8803f;
    --text: #3b2a1e;
    --muted: #8a7566;
    --ok: #4f7a4f;
    --warn: #b5523b;
    --line: #d9c7b0;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #2a211b; --paper: #352a22; --brown: #d9b48f; --brown-2: #c8803f;
      --accent: #e0a060; --text: #f3e6d6; --muted: #b59c86; --line: #51402f;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; font-family: "Tahoma", "Segoe UI", sans-serif;
    background: var(--bg); color: var(--text);
    padding: env(safe-area-inset-top, 0px) 12px env(safe-area-inset-bottom, 0px);
  }
  .wrap { max-width: 1400px; width: 100%; margin: 0 auto; }
  h1 {
    text-align: center; color: var(--brown); font-size: 1.6rem;
    border: 2px solid var(--brown-2); border-radius: 14px;
    padding: 10px; margin: 16px auto; max-width: 340px; background: var(--paper);
  }
  .fields {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 10px; margin-bottom: 14px;
  }
  .field label { display: block; font-size: .85rem; color: var(--muted); margin-bottom: 4px; }
  .field select, .field input { height: 44px; }
  @media (max-width: 640px) { .fields { grid-template-columns: repeat(2, 1fr); } }
  .field input, .field select {
    width: 100%; padding: 9px 10px; border: 1px solid var(--line);
    border-radius: 10px; background: var(--paper); color: var(--text); font-size: 1rem;
  }
  .toolbar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; align-items: center; }
  .btn {
    border: none; border-radius: 10px; padding: 9px 14px; cursor: pointer;
    background: var(--brown); color: var(--paper); font-size: .95rem;
  }
  .btn.secondary { background: var(--brown-2); }
  .btn.ghost { background: transparent; color: var(--brown); border: 1px solid var(--brown-2); }
  .stats { margin-inline-start: auto; color: var(--muted); font-size: .9rem; }
  .tables { display: grid; grid-template-columns: 1fr; gap: 12px; width: 100%; }
  .tables .table-wrap { width: 100%; }
  @media (max-width: 640px) { .tables { grid-template-columns: 1fr; } }
  .table-wrap { overflow-x: auto; border-radius: 12px; border: 1px solid var(--line); background: var(--paper); }
  table { width: 100%; border-collapse: collapse; min-width: 100%; }
  td.name { min-width: calc(340px - 4cm); width: calc(45% - 4cm); }
  td.name input { min-width: calc(300px - 4cm); }
  td.name input { width: 100%; white-space: nowrap; text-align: center; padding: 7px 8px !important; }
  tbody td:nth-child(3) { white-space: nowrap; }
  tbody td:nth-child(3) .chip { display: inline-block; margin: 2px 3px; }
  th, td { padding: 6px 8px; border-bottom: 1px solid var(--line); text-align: center; }
  th { background: var(--brown); color: var(--paper); font-weight: 600; font-size: .9rem; }
  td.num { width: 56px; font-weight: 700; color: var(--brown); }
  td.name input {
    width: 100%; padding: 7px 8px; border: 1px solid var(--line); border-radius: 8px;
    background: transparent; color: var(--text); font-size: .95rem;
  }
  td.note input {
    width: 100%; padding: 7px 8px; border: 1px solid var(--line); border-radius: 8px;
    background: transparent; color: var(--text); font-size: .9rem;
  }
  .chip {
    border: 1px solid var(--accent); background: transparent; color: var(--text);
    border-radius: 999px; padding: 5px 12px; cursor: pointer; font-size: .85rem;
  }
  .chip.on { background: var(--accent); color: #fff; }
  .chip.absent.on { background: var(--warn); border-color: var(--warn); }
  .chip.follow.on { background: var(--ok); border-color: var(--ok); }
  .chip.follow { min-width: 52px; font-weight: 700; font-size: .95rem; }
  .hint { color: var(--muted); font-size: .8rem; margin-top: 10px; }
  .overlay { position: fixed; inset: 0; background: rgba(0,0,0,.45); display: none; align-items: center; justify-content: center; z-index: 50; padding: 12px; }
  .panel { background: var(--bg); border: 1px solid var(--line); border-radius: 14px; max-width: 560px; width: 100%; max-height: 90vh; display: flex; flex-direction: column; }
  .panel-head { padding: 12px 16px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; font-weight: 700; color: var(--brown); gap: 8px; }
  .panel-body { overflow-y: auto; padding: 12px 16px; }
  .month { margin-bottom: 14px; }
  .mname { font-weight: 600; margin-bottom: 6px; color: var(--brown); }
  input.mname { width: 100%; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); color: var(--brown); font-weight: 600; padding: 4px 8px; font-family: inherit; font-size: .95rem; margin-bottom: 6px; }
  .days { display: grid; grid-template-columns: repeat(10, 1fr); gap: 4px; }
  .day { aspect-ratio: 1; border: 1px solid var(--line); background: var(--paper); color: var(--text); border-radius: 4px; font-size: .7rem; padding: 0; cursor: pointer; }
  .abscount { text-align: center; font-size: 1.1rem; color: var(--brown); background: var(--paper); border: 2px solid var(--warn); border-radius: 12px; padding: 8px; margin-bottom: 12px; }
  .abscount b { color: var(--warn); font-size: 1.4rem; }
  .day.on { background: var(--warn); border-color: var(--warn); color: #fff; }
  .gtable { width: 100%; border-collapse: collapse; }
  .gtable th, .gtable td { padding: 4px 6px; border-bottom: 1px solid var(--line); text-align: center; }
  .gtable tfoot th { color: var(--brown); font-size: 1.05rem; border-top: 2px solid var(--brown); padding-top: 12px; }
  .gin { width: 90px; padding: 4px 6px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); color: var(--text); text-align: center; }
  .gname { width: 100%; min-width: 120px; padding: 4px 6px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); color: var(--text); }
  .gmax { width: 70px; padding: 4px 6px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); color: var(--text); text-align: center; }
  .gsum { display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 1rem; padding: 2px 0; color: var(--brown); }
  .gsum b { display: inline-block; min-width: 56px; text-align: center; font-size: 1.5rem; color: var(--accent); background: var(--paper); border: 2px solid var(--accent); border-radius: 12px; padding: 4px 12px; }
  .gsum b.gmaxb { color: var(--brown); border-color: var(--brown-2); }
  .gsum span { color: var(--muted); }
  .btn:disabled { opacity: .4; cursor: default; }
  .zoomctl { display: inline-flex; gap: 6px; }
  .zoomctl .btn { padding: 4px 12px; font-size: 1.1rem; line-height: 1; }
  #folModal { background: rgba(0,0,0,.2); }
  #folModal .panel { box-shadow: 0 12px 40px rgba(0,0,0,.35); border-radius: 16px; }
  #folModal .panel-head { touch-action: none; cursor: move; user-select: none; }
  .xbtn { border: 1px solid var(--warn); background: var(--warn); color: #fff; font-size: 1.1rem; font-weight: 700; cursor: pointer; padding: 4px 10px; border-radius: 8px; line-height: 1; }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 8px 0; flex-wrap: wrap; }
  .ntext { width: 100%; min-height: 220px; padding: 10px; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); color: var(--text); font-size: 1rem; font-family: inherit; resize: vertical; }
  @media print {
    @page { size: A4; margin: 12mm; }
    body { background: #fff; color: #000; padding: 0; font-size: 11pt; }
    .toolbar, .hint, .overlay, .btn, .chip, .xbtn, .stats { display: none !important; }
    .wrap { max-width: none; }
    h1 { border: 1px solid #000; background: #fff; color: #000; max-width: none; }
    .fields { display: grid !important; grid-template-columns: repeat(4, 1fr); gap: 6px; }
    .field label { color: #000; }
    .field select, .field input { border: 1px solid #000 !important; background: #fff !important; color: #000 !important; height: 32px; }
    .tables { display: block; }
    .table-wrap { border: none; overflow: visible; background: #fff; }
    table { min-width: 0 !important; }
    td.name { width: auto; min-width: 0 !important; }
    td.name input { min-width: 0; width: 100%; border: none; border-bottom: 1px solid #000; border-radius: 0; background: transparent; color: #000; padding: 4px; }
    tbody td:nth-child(3) { min-width: 160px; white-space: normal; }
    td:nth-child(4) { display: none; }
    th, td { border: 1px solid #000; padding: 4px 6px; color: #000; }
    th { background: #ddd !important; color: #000 !important; }
    tr { page-break-inside: avoid; }
  }
</style>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#6b4a36">
<link rel="icon" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-512.png">
</head>
<body>
<div class="wrap">
  <h1>سجل الطلاب</h1>

  <div class="fields">
    <div class="field"><label for="date">التاريخ الميلادي</label><input type="date" id="date"></div>
    <div class="field"><label for="grade">الصف</label><select id="grade"><option value="الصف الأول">الصف الأول</option><option value="الصف الثاني">الصف الثاني</option><option value="الصف الثالث">الصف الثالث</option><option value="الصف الرابع">الصف الرابع</option><option value="الصف الخامس">الصف الخامس</option><option value="الصف السادس">الصف السادس</option></select></div>
    <div class="field"><label for="section">الشعبة</label><select id="section"><option value="أ">أ</option><option value="ب">ب</option><option value="ج">ج</option></select></div>
    <div class="field">
      <label for="month">الشهر</label>
      <select id="month"></select>
    </div>
  </div>

  <div class="toolbar">
    <button class="btn" id="addBtn">+</button>
    <button class="btn secondary" id="backupBtn">نسخة احتياطية</button>
    <button class="btn ghost" id="restoreBtn">استعادة</button>
    <input type="file" id="restoreFile" hidden>
    <span class="stats" id="stats"></span>
  </div>

  <div class="tables">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ت</th>
            <th>اسم الطالب</th>
            <th>المحتوى</th>
          </tr>
        </thead>
        <tbody id="rowsRight"></tbody>
      </table>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ت</th>
            <th>اسم الطالب</th>
            <th>المحتوى</th>
          </tr>
        </thead>
        <tbody id="rowsLeft"></tbody>
      </table>
    </div>
  </div>
  <p class="hint">تُحفظ البيانات تلقائياً في هذا المتصفح. استخدم "نسخة احتياطية" لحفظ ملف نسخة من السجل.</p>
</div>

<div class="overlay" id="absModal">
  <div class="panel">
    <div class="panel-head"><span id="absTitle"></span><button class="btn" id="absClose">إغلاق</button></div>
    <div class="panel-body" id="absBody"></div>
  </div>
</div>

<div class="overlay" id="folModal">
  <div class="panel">
    <div class="panel-head"><span id="folTitle"></span><button class="btn" id="folClose">إغلاق</button></div>
    <div class="panel-body" id="folBody"></div>
  </div>
</div>

<div class="overlay" id="noteModal">
  <div class="panel">
    <div class="panel-head"><span id="noteTitle"></span><button class="btn" id="noteClose">إغلاق</button></div>
    <div class="panel-body" id="noteBody"></div>
  </div>
</div>

<div class="overlay" id="bkModal">
  <div class="panel">
    <div class="panel-head"><span id="bkTitle"></span><button class="btn" id="bkClose">إغلاق</button></div>
    <div class="panel-body">
      <p class="hint" id="bkHelp" style="margin-top:0"></p>
      <textarea id="bkText" class="ntext" style="min-height:260px;direction:ltr;font-size:.8rem;"></textarea>
      <div class="nav"><button class="btn" id="bkAction"></button></div>
    </div>
  </div>
</div>

<script>
const $ = id => document.getElementById(id);
const APP_NAME = "سجل الطلاب";
document.title = APP_NAME;
document.querySelector("h1").textContent = APP_NAME;
const TOTAL = 50;
const MONTHS = ["يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"];
const KEY = "student-register-v1";

const ABS_MONTHS = [
  { key: "2026-10", name: "شهر 1" },
  { key: "2026-11", name: "شهر 2" },
  { key: "2026-12", name: "شهر 3" },
  { key: "2027-01", name: "شهر 4" },
  { key: "2027-02", name: "شهر 5" },
  { key: "2027-03", name: "شهر 6" },
  { key: "2027-04", name: "شهر 7" },
  { key: "2027-05", name: "شهر 8" }
];

function hasAbsence(s) {
  return Object.values(s.absences || {}).some(arr => arr.some(Boolean));
}

let absModalStudent = null;

function openAbsence(s, idx) {
  absModalStudent = s;
  $("absTitle").textContent = "الغياب - الطالب " + (idx + 1) + (s.name.trim() ? " : " + s.name : "");
  renderAbsence();
  $("absModal").style.display = "flex";
}

function monthName(m) {
  return (state.monthNames || {})[m.key] || m.name;
}

function absTotal(s) {
  return ABS_MONTHS.reduce((t, m) => t + (((s.absences && s.absences[m.key]) || []).filter(Boolean).length), 0);
}

function renderAbsence() {
  const s = absModalStudent;
  s.absences = s.absences || {};
  $("absBody").innerHTML = `<div class="abscount">عدد أيام الغياب: <b id="absCount">${absTotal(s)}</b></div>` + ABS_MONTHS.map(m => {
    const arr = s.absences[m.key] || Array(30).fill(false);
    const boxes = arr.map((on, d) =>
      `<button class="day ${on ? "on" : ""}" data-m="${m.key}" data-d="${d}">${d + 1}</button>`
    ).join("");
    return `<div class="month"><input class="mname" type="text" data-mk="${m.key}" value="${escapeHtml(monthName(m))}"><div class="days">${boxes}</div></div>`;
  }).join("");
  $("absBody").querySelectorAll(".mname").forEach(inp => {
    inp.addEventListener("input", () => {
      state.monthNames = state.monthNames || {};
      state.monthNames[inp.dataset.mk] = inp.value;
      save();
    });
  });
  $("absBody").querySelectorAll(".day").forEach(b => {
    b.addEventListener("click", () => {
      const k = b.dataset.m, d = +b.dataset.d;
      s.absences[k] = s.absences[k] || Array(30).fill(false);
      s.absences[k][d] = !s.absences[k][d];
      b.classList.toggle("on", s.absences[k][d]);
      $("absCount").textContent = absTotal(s);
      save();
    });
  });
}

function closeAbsence() {
  $("absModal").style.display = "none";
  absModalStudent = null;
  buildRows();
  save();
}

$("absClose").addEventListener("click", closeAbsence);
$("absModal").addEventListener("click", e => { if (e.target.id === "absModal") closeAbsence(); });

const DEFAULT_SUBJECTS = [
  { key: "qawaed", name: "قواعد", max: 30 },
  { key: "taabeer", name: "تعبير", max: 30 },
  { key: "qiraa", name: "قراءة", max: 10 },
  { key: "mahfoza", name: "محفوظة", max: 10 },
  { key: "imlaa", name: "إملاء", max: 10 },
  { key: "khatt", name: "خط", max: 10 }
];

function subjects() { return state.subjects; }

function maxTotal() { return subjects().reduce((t, x) => t + (Number(x.max) || 0), 0); }

function G(s) {
  s.gradesByMonth = s.gradesByMonth || {};
  const k = state.month || "";
  s.gradesByMonth[k] = s.gradesByMonth[k] || {};
  return s.gradesByMonth[k];
}

function hasGrades(s) {
  return Object.values(G(s)).some(v => v !== "" && v != null);
}

function hasAnyGrades(s) {
  return Object.values(s.gradesByMonth || {}).some(g => Object.values(g).some(v => v !== "" && v != null));
}

function gradeTotal(s) {
  return subjects().reduce((t, sub) => t + (Number(G(s)[sub.key]) || 0), 0);
}

let folStudent = null;

function openFollow(s, idx) {
  folStudent = s;
  $("folTitle").textContent = "المتابعة - الطالب " + (idx + 1) + (s.name.trim() ? " : " + s.name : "");
  renderFollow();
  folX = 0; folY = 0; folZoom = 1; applyZoom();
  $("folModal").style.display = "flex";
}

function renderFollow() {
  const s = folStudent;
  const list = subjects();
  $("folBody").innerHTML = `
    <table class="gtable">
      <thead><tr><th>اسم المادة</th><th>الدرجة</th><th>من</th><th></th></tr></thead>
      <tbody>
        ${list.map(sub => `
          <tr>
            <td><input class="gname" type="text" placeholder="اسم المادة" data-k="${sub.key}" value="${escapeHtml(sub.name)}"></td>
            <td><input class="gin" type="number" min="0" data-k="${sub.key}" value="${G(s)[sub.key] != null ? G(s)[sub.key] : ""}"></td>
            <td><input class="gmax" type="number" min="0" placeholder="من" data-k="${sub.key}" value="${sub.max || ""}"></td>
            <td><button class="xbtn gdel" data-k="${sub.key}" title="حذف المادة">×</button></td>
          </tr>`).join("")}
      </tbody>
      <tfoot><tr><th colspan="4"><div class="gsum"><span>المجموع</span><b id="folTotal">${gradeTotal(s)}</b><span>من</span><b class="gmaxb" id="folMax">${maxTotal()}</b></div></th></tr></tfoot>
    </table>
    <div class="nav"><button class="btn secondary" id="gAdd">إضافة مادة</button></div>`;

  const refresh = () => {
    $("folTotal").textContent = gradeTotal(s);
    $("folMax").textContent = maxTotal();
    save();
  };

  $("folBody").querySelectorAll(".gname").forEach(inp => {
    inp.addEventListener("input", () => {
      const sub = subjects().find(x => x.key === inp.dataset.k);
      sub.name = inp.value;
      save();
    });
  });
  $("folBody").querySelectorAll(".gin").forEach(inp => {
    inp.addEventListener("input", () => {
      const sub = subjects().find(x => x.key === inp.dataset.k);
      const cap = sub.max > 0 ? sub.max : Infinity;
      let v = inp.value === "" ? "" : Math.min(Math.max(Number(inp.value), 0), cap);
      if (v !== "" && Number(inp.value) !== v) inp.value = v;
      G(s)[sub.key] = v;
      refresh();
    });
  });
  $("folBody").querySelectorAll(".gmax").forEach(inp => {
    inp.addEventListener("input", () => {
      const sub = subjects().find(x => x.key === inp.dataset.k);
      sub.max = Number(inp.value) || 0;
      if (sub.max && G(s)[sub.key] > sub.max) G(s)[sub.key] = sub.max;
      refresh();
    });
  });
  $("folBody").querySelectorAll(".gdel").forEach(btn => {
    btn.addEventListener("click", () => {
      state.subjects = state.subjects.filter(x => x.key !== btn.dataset.k);
      renderFollow();
      save();
    });
  });
  $("gAdd").addEventListener("click", () => {
    state.subjects.push({ key: "s" + Date.now(), name: "", max: 0 });
    renderFollow();
    save();
  });
}

function closeFollow() {
  $("folModal").style.display = "none";
  folStudent = null;
  buildRows();
  save();
}

$("folClose").addEventListener("click", closeFollow);
let folZoom = 1, folX = 0, folY = 0;
let pinchDist = 0, pinchBase = 1;
function applyZoom() {
  const p = document.querySelector("#folModal .panel");
  p.style.transformOrigin = "center center";
  p.style.transform = "translate(" + folX + "px, " + folY + "px) scale(" + folZoom + ")";
}
function